# New, isolated Supabase project for this app — NOT the CelebrateYouHub/
# proageing-site shared project. See docs/PLAN.md §6 and §9.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The CelebrateYouHub/proageing-site shared project — used only by the
# manual "history under another email" fallback (lib/sharedSupabase.ts,
# app/import). Values are already public in CelebrateYouHub's js/config.js
# (window.SUPABASE_CONFIG) — copy them from there.
NEXT_PUBLIC_SHARED_SUPABASE_URL=
NEXT_PUBLIC_SHARED_SUPABASE_ANON_KEY=

# The same legacy proageing.org project again, but service_role and
# server-only — never NEXT_PUBLIC_. This is what makes the automatic import
# work: matching a person across the two projects means reading auth.users
# on the legacy side, which the anon key above cannot do.
#
# READ-ONLY USE. proageing.org's project is frozen; nothing in this app
# writes to it, and lib/siteSupabaseAdmin.ts offers no way to.
#
# With these unset the automatic import quietly does nothing and the app
# behaves exactly as before — so this is safe to deploy before filling them
# in. Same two values proageing-admin uses for its /site-users view.
SITE_SUPABASE_URL=
SITE_SUPABASE_SERVICE_ROLE_KEY=

# Stripe Singapore — see docs/PLAN.md §5 for the products/prices to create.
# Price IDs come from whatever products/prices you create in the Stripe
# dashboard for each row of the pricing table (lib/plans.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_21DAY=
STRIPE_PRICE_90DAY=

# Service role key for the new Supabase project — server-only (app/api
# routes), never NEXT_PUBLIC_. Used by the Stripe webhook handler to write
# to `subscriptions`, which RLS otherwise locks to service_role. Find it in
# Supabase dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
